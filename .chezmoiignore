{{- /* Machines initialised before .profile existed have no such key. Fall back
       to "full", which is what they were already getting.

       Keep this block at the very top of the file. Whitespace trimming here
       (`{{-`) reaches backwards across newlines, so a template action placed
       directly after a comment line silently glues the next pattern onto the
       end of that comment and it stops being a pattern at all. */ -}}
{{- $profile := "full" -}}
{{- if hasKey . "profile" }}{{ $profile = .profile }}{{ end }}

# ---------------------------------------------------------------------------
# Always evaluated as a Go template.
#
# Patterns match TARGET paths, not source names: ".claude/agents", never
# "dot_claude/agents". Script prefixes are stripped too, so the source file
# run_once_install-packages.sh is matched here as "install-packages.sh".
#
# Exclusions (!) beat inclusions regardless of line order, and a directory has
# to be un-ignored separately from its contents -- hence the "!.claude" plus
# "!.claude/**" pair below. Un-ignoring "!.claude/**" also means nothing
# underneath ~/.claude can be re-ignored while the claude profile is active.
# ---------------------------------------------------------------------------

README.md
.DS_Store
**/.DS_Store

# Keys and tokens. This repo is PUBLIC, so the real file must never enter the
# source state. ~/.zshrc sources it from the block that modify_dot_zshrc injects,
# guarded by [ -r ] so a machine without it still gets a working shell. The
# committed .example alongside it documents the expected variables, no values.
.config/zsh/secrets.zsh

# chezmoi's own config is GENERATED by `chezmoi init` from .chezmoi.toml.tmpl.
# It must never also be a managed target: apply would overwrite the generated
# file, drop .profile, and break this very template.
.config/chezmoi/**

# asdf is gone -- mise replaces it, with versions pinned in
# dot_config/mise/config.toml. These lines were originally needed because
# dot_asdf/ held 2073 files / 93MB of node-16.16.0 binaries captured by mistake,
# which `chezmoi apply` would have written into a ~/.asdf that no machine has.
# They stay as a guard so a stray `chezmoi add ~/.asdf` cannot reintroduce it.
.asdf
.asdf/**

# Source tree for the Claude agent definitions -- not a dotfile. agents/sync.sh
# renders it into ~/.claude and into dot_claude/ here. Without these lines a
# top-level source directory called "agents" would deploy as ~/agents.
agents
agents/**

{{ if eq $profile "claude" }}
# --- profile: claude -------------------------------------------------------
# Manage nothing but ~/.claude.
**
!.claude
!.claude/**
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
# --- non-macOS -------------------------------------------------------------
# Homebrew, Xcode, karabiner and the macOS defaults script are darwin-only.
.Brewfile
Brewfile
install-packages.sh
setup-macos.sh
.init-setup
.config/karabiner/**
{{ end }}
