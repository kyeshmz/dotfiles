# Template for ~/.config/zsh/secrets.zsh — copy it, then fill in real values.
#
#   cp ~/.config/zsh/secrets.zsh.example ~/.config/zsh/secrets.zsh
#   chmod 600 ~/.config/zsh/secrets.zsh
#   $EDITOR ~/.config/zsh/secrets.zsh
#
# THIS file is committed; secrets.zsh is not — .chezmoiignore excludes it, and
# the repo is public. Keep it that way: put every key here and nothing in
# ~/.zshrc itself. modify_dot_zshrc's managed block sources it automatically,
# guarded by [ -r ], so a machine without this file still gets a working shell.
#
# The values do not sync. On a new machine you re-fill them from your password
# manager. `bw` (Bitwarden) is installed and in both Brewfiles if you later want
# chezmoi to template these in at apply time instead.

# export CLAUDE_CODE_OAUTH_TOKEN=""
# export ANTHROPIC_API_KEY=""
# export OPENAI_API_KEY=""
# export GITHUB_TOKEN=""
