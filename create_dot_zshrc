# Starter ~/.zshrc.
#
# The create_ prefix means chezmoi writes this ONLY when ~/.zshrc does not
# already exist, and never touches an existing one. A long-lived machine
# accumulates tool installers' additions (nvm, bun, pnpm, pipx, gcloud...) and
# clobbering that on every `chezmoi apply` would be destructive. Edit this file
# for what a NEW machine should start with, not to push changes to old ones.

# Runtimes are managed by mise, which replaced asdf. Versions come from
# ~/.config/mise/config.toml; run `mise install` to materialise them.
eval "$(mise activate zsh)"

export PATH="/opt/homebrew/opt/ssh-copy-id/bin:$PATH"
export PATH="$PATH:$HOME/.pub-cache/bin"

export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"

# Guarded: these are absent on a machine without the gcloud cask, and an
# unguarded `source` would make every new shell start with an error.
if [ -f '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc' ]; then
	. '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc'
fi
if [ -f '/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc' ]; then
	. '/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc'
fi

autoload -Uz compinit && compinit

eval "$(starship init zsh)"
