#!/bin/sh
# Inject a managed block into ~/.zshrc, leaving everything else alone.
#
# chezmoi runs this with the CURRENT ~/.zshrc on stdin and uses our stdout as the
# new ~/.zshrc. The repo therefore stores THIS SCRIPT, never the file's contents
# — so machine-local lines and any keys sitting in ~/.zshrc are never read into
# the source tree and cannot be committed. That is the whole point: there is no
# `chezmoi add ~/.zshrc` step to leak anything.
#
# Secrets do not belong in this file either. The block sources
# ~/.config/zsh/secrets.zsh, which .chezmoiignore excludes, so it never becomes
# part of the source state. See dot_config/zsh/secrets.zsh.example.
set -eu

BEGIN='# >>> chezmoi managed >>>'
END='# <<< chezmoi managed <<<'

existing=$(cat)

# Everything outside the previous block, verbatim. Re-running is idempotent
# because the old block is stripped before the new one is written.
rest=$(printf '%s\n' "$existing" | sed "/^${BEGIN}\$/,/^${END}\$/d")

cat <<'BLOCK'
# >>> chezmoi managed >>>
# Generated by chezmoi from modify_dot_zshrc. Edits inside this block are
# overwritten on the next `chezmoi apply` — put machine-local things outside it.

# Runtimes. mise replaced asdf/nvm/pyenv/chruby; versions come from
# ~/.config/mise/config.toml.
eval "$(mise activate zsh)"

export PATH="/opt/homebrew/opt/ssh-copy-id/bin:$PATH"
export PATH="$PATH:$HOME/.pub-cache/bin"

autoload -Uz compinit && compinit

# Keys and tokens. Untracked and chezmoi-ignored, so nothing here reaches the
# repo. Guarded so a machine that has not set it up yet still gets a working
# shell. Copy dot_config/zsh/secrets.zsh.example to seed it.
[ -r "$HOME/.config/zsh/secrets.zsh" ] && . "$HOME/.config/zsh/secrets.zsh"

eval "$(starship init zsh)"
# <<< chezmoi managed <<<
BLOCK

printf '%s\n' "$rest"
