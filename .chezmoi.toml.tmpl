{{/*
   Per-machine config, generated by `chezmoi init`. Never edit ~/.config/chezmoi/chezmoi.toml
   by hand — regenerate it with `chezmoi init` (or .bootstrap/init.sh) instead.

   .profile decides WHAT this machine gets. .chezmoiignore reads it.

     claude  Only ~/.claude — agent definitions, skills, commands. Nothing else:
             no Homebrew, no macOS scripts, no shell/ssh/mise config. Safe on a
             machine that will never have brew, and on any OS.
     full    Everything in this repo.

   Answer it non-interactively at install time with:
     chezmoi init --apply kyeshmz/dotfiles --promptChoice 'Profile=claude'
*/}}
{{- $profile := promptChoiceOnce . "profile" "Profile" (list "claude" "full") "claude" -}}

[data]
    profile = {{ $profile | quote }}
{{- if eq $profile "full" }}
{{- $email := promptStringOnce . "email" "Email address" }}
    email = {{ $email | quote }}
{{- end }}

[git]
    autoCommit = true
    autoPush = true
    autoSetupRemote = true
